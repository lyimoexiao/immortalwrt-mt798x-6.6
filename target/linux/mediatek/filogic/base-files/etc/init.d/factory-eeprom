#!/bin/sh /etc/rc.common

START=09

# The MT7981/MT7986 vendor Wi-Fi driver reads calibration through an e2p
# image in /lib/firmware, not from the Factory partition. The vendor
# firmware ships a generic e2p image, reads a few "calibration block
# address" fields from Factory (0x54B-0x563, 0x9A8 on MT7981) and patches
# the image with iwpriv, then writes it back with ated. Copying the whole
# Factory partition instead keeps every internal address consistent with
# the original layout, so no patching step is needed.
#
# The driver only reads the image when the module loads, which happens
# before this script runs, so the calibration takes effect on the next
# boot. l1profile.dat reads offset 0 with a size that covers the whole
# partition.

FW_DIR=/lib/firmware
E2P="$FW_DIR/e2p"
MARKER=/etc/.factory-eeprom-done

find_factory_mtd() {
	local dev name

	[ -r /proc/mtd ] || return 1
	while read -r dev _ _ name; do
		case "$dev" in
		mtd*:) ;;
		*) continue ;;
		esac
		[ "$name" = '"Factory"' ] || continue
		echo "/dev/${dev%:}"
		return 0
	done < /proc/mtd
	return 1
}

factory_signature_ok() {
	local mtd="$1"

	# MT7981/MT7986 EEPROM images start with 0x7981 / 0x7986 (little endian)
	printf '\201\171' > /tmp/.factory-sig
	dd if="$mtd" bs=2 count=1 of=/tmp/.factory-head 2>/dev/null
	if cmp -s /tmp/.factory-sig /tmp/.factory-head; then
		rm -f /tmp/.factory-sig /tmp/.factory-head
		return 0
	fi
	rm -f /tmp/.factory-sig /tmp/.factory-head
	return 1
}

boot() {
	[ -f "$MARKER" ] && return 0
	[ -d /sys/module/mt_wifi ] || [ -e /lib/modules/$(uname -r)/mt_wifi.ko ] || return 0

	mtd="$(find_factory_mtd)" || return 0
	[ -c "$mtd" ] || return 0
	factory_signature_ok "$mtd" || {
		echo "factory-eeprom: no usable calibration in $mtd, keeping the default image" >&2
		return 0
	}

	mkdir -p "$FW_DIR"
	dd if="$mtd" of="$E2P" bs=128k 2>/dev/null || return 0
	sync

	touch "$MARKER"
	echo "factory-eeprom: calibration installed from $mtd" >&2
}
